# Hedera network
HEDERA_NETWORK=testnet
MIRROR_NODE_URL=https://testnet.mirrornode.hedera.com
USDC_TOKEN_ID=0.0.429274

# ARIA Bot (Treasury) - pays reimbursements. ECDSA key (0x...) is fine.
ARIA_ACCOUNT_ID=0.0.xxxxx
ARIA_PRIVATE_KEY=0x...

# Corporate Issuer - issues the Verifiable Credential. Filled in by setup:accounts.
ISSUER_ACCOUNT_ID=
ISSUER_PRIVATE_KEY=

# Employee (Requestor) - receives the reimbursement. Filled in by setup:accounts.
EMPLOYEE_ACCOUNT_ID=
EMPLOYEE_PRIVATE_KEY=

# Filled in by setup:identity
EMPLOYEE_DID=
EMPLOYEE_DID_TOPIC_ID=
ISSUER_DID=
ISSUER_DID_TOPIC_ID=
EMPLOYEE_MONTHLY_LIMIT_USD=150
ACTIVE_VC_ID=

EMPLOYEE_SERVER_PORT=4000
EMPLOYEE_SERVER_URL=http://localhost:4000
